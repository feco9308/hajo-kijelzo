{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build STM32G431CBU6",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/build.ps1"],
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Flash ST-LINK (replaces firmware)",
      "type": "process",
      "command": "powershell",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/flash.ps1"],
      "dependsOn": "Build STM32G431CBU6",
      "problemMatcher": []
    }
  ]
}
